{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://practical-game-studio.dev/schemas/milestone.schema.json",
  "title": "PGS Milestone Review",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "milestone", "success_criteria", "criteria_results", "supporting_evidence", "blocking_issues", "verdict", "recommendation", "next_milestone"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "milestone": {"type": "string", "minLength": 1},
    "success_criteria": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "criteria_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "criterion", "required", "result", "evidence_references", "related_issues", "related_decisions", "notes"],
        "properties": {
          "id": {"type": "string", "pattern": "^MC-[0-9]{3,}$"},
          "criterion": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"},
          "result": {"enum": ["pass", "partial", "fail", "unknown"]},
          "evidence_references": {"type": "array", "items": {"type": "string", "pattern": "^EVD-[0-9]{3,}$"}, "uniqueItems": true},
          "related_issues": {"type": "array", "items": {"type": "string", "pattern": "^ISS-[0-9]{3,}$"}, "uniqueItems": true},
          "related_decisions": {"type": "array", "items": {"type": "string", "pattern": "^DEC-[0-9]{3,}$"}, "uniqueItems": true},
          "notes": {"type": "string"}
        }
      }
    },
    "supporting_evidence": {"type": "array", "items": {"type": "string", "pattern": "^EVD-[0-9]{3,}$"}, "uniqueItems": true},
    "blocking_issues": {"type": "array", "items": {"type": "string", "pattern": "^ISS-[0-9]{3,}$"}, "uniqueItems": true},
    "verdict": {"enum": ["PROCEED", "ITERATE", "PIVOT", "PAUSE", "STOP"]},
    "recommendation": {"type": "string", "minLength": 1},
    "next_milestone": {"type": ["string", "null"]}
  }
}
