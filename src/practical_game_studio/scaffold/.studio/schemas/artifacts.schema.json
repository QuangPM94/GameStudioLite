{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://practical-game-studio.dev/schemas/artifacts.schema.json",
  "title": "PGS Execution Artifacts",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifacts"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "path", "mime_type", "sha256", "size_bytes", "source_run", "created_at", "captured_at", "revision", "status", "description", "metadata"],
        "properties": {
          "id": {"type": "string", "pattern": "^ART-[0-9]{4,}$"},
          "type": {"enum": ["log", "build", "screenshot", "video", "test-report", "telemetry", "profile", "export", "text", "json", "other"]},
          "path": {"type": "string", "minLength": 1},
          "mime_type": {"type": ["string", "null"], "minLength": 1},
          "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "size_bytes": {"type": ["integer", "null"], "minimum": 0},
          "source_run": {"type": ["string", "null"], "pattern": "^RUN-[0-9]{4,}$"},
          "created_at": {"type": "string", "format": "date-time"},
          "captured_at": {"type": ["string", "null"], "format": "date-time"},
          "revision": {"type": ["string", "null"], "minLength": 1},
          "status": {"enum": ["present", "missing", "modified", "unverified"]},
          "description": {"type": ["string", "null"], "minLength": 1},
          "metadata": {"type": "object"}
        }
      }
    }
  }
}
