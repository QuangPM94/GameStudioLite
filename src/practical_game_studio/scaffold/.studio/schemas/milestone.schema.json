{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://practical-game-studio.dev/schemas/milestone.schema.json",
  "title": "PGS Milestone Review and Criteria",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "milestone",
    "milestone_id",
    "milestones",
    "next_milestone_id",
    "criteria_results",
    "supporting_evidence",
    "blocking_issues",
    "verdict",
    "recommendation",
    "next_milestone"
  ],
  "properties": {
    "schema_version": {"const": "3.2"},
    "milestone": {"type": "string", "minLength": 1},
    "milestone_id": {"type": ["string", "null"], "pattern": "^MS-[0-9]{4,}$"},
    "next_milestone_id": {"type": ["string", "null"], "pattern": "^MS-[0-9]{4,}$"},
    "milestones": {
      "type": "array",
      "items": {"$ref": "#/$defs/milestoneRecord"}
    },
    "criteria_results": {
      "type": "array",
      "items": {"$ref": "#/$defs/criterion"}
    },
    "supporting_evidence": {
      "type": "array",
      "items": {"type": "string", "pattern": "^EVD-[0-9]{3,}$"},
      "uniqueItems": true
    },
    "blocking_issues": {
      "type": "array",
      "items": {"type": "string", "pattern": "^ISS-[0-9]{3,}$"},
      "uniqueItems": true
    },
    "verdict": {"enum": ["PROCEED", "ITERATE", "PIVOT", "PAUSE", "STOP"]},
    "recommendation": {"type": "string", "minLength": 1},
    "next_milestone": {"type": ["string", "null"]}
  },
  "$defs": {
    "milestoneRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "status", "created_at", "updated_at"],
      "properties": {
        "id": {"type": "string", "pattern": "^MS-[0-9]{4,}$"},
        "title": {"type": "string", "minLength": 1},
        "status": {"enum": ["current", "known", "retired"]},
        "created_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"}
      }
    },
    "evidenceSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "classification", "status"],
      "properties": {
        "id": {"type": "string", "pattern": "^EVD-[0-9]{3,}$"},
        "classification": {
          "enum": ["observed", "user-reported", "inferred", "unknown"]
        },
        "status": {"enum": ["active", "superseded", "retracted"]}
      }
    },
    "evaluationHistory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "support_status",
        "reason",
        "evidence_snapshot",
        "issue_references",
        "decision_references",
        "limitations",
        "evaluated_at"
      ],
      "properties": {
        "support_status": {
          "enum": [
            "unsupported",
            "partially-supported",
            "verified",
            "contradicted"
          ]
        },
        "reason": {"type": "string", "minLength": 1},
        "evidence_snapshot": {
          "type": "array",
          "items": {"$ref": "#/$defs/evidenceSnapshot"}
        },
        "issue_references": {
          "type": "array",
          "items": {"type": "string", "pattern": "^ISS-[0-9]{3,}$"},
          "uniqueItems": true
        },
        "decision_references": {
          "type": "array",
          "items": {"type": "string", "pattern": "^DEC-[0-9]{3,}$"},
          "uniqueItems": true
        },
        "limitations": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "evaluated_at": {"type": "string", "format": "date-time"}
      }
    },
    "milestoneHistory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "changed_at"],
      "properties": {
        "from": {"type": "string", "minLength": 1},
        "to": {"type": "string", "minLength": 1},
        "changed_at": {"type": "string", "format": "date-time"}
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "milestone",
        "milestone_id",
        "description",
        "required",
        "lifecycle_status",
        "support_status",
        "completion_condition",
        "verification_method",
        "verification_policy",
        "related_issues",
        "related_decisions",
        "supporting_evidence",
        "evaluation_reason",
        "evaluation_limitations",
        "evaluation_history",
        "evaluation_freshness",
        "milestone_history",
        "created_at",
        "updated_at",
        "evaluated_at",
        "retired_at",
        "retirement_reason"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^MC-[0-9]{3,}$"},
        "milestone": {"type": "string", "minLength": 1},
        "milestone_id": {"type": ["string", "null"], "pattern": "^MS-[0-9]{4,}$"},
        "description": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"},
        "lifecycle_status": {"enum": ["active", "retired"]},
        "support_status": {
          "enum": [
            "unsupported",
            "partially-supported",
            "verified",
            "contradicted"
          ]
        },
        "completion_condition": {"type": "string", "minLength": 1},
        "verification_method": {"type": ["string", "null"], "minLength": 1},
        "verification_policy": {
          "type": "string",
          "enum": [
            "observed-player-behavior",
            "observed-runtime",
            "automated-test",
            "document-review",
            "source-review",
            "manual-approval",
            "mixed"
          ]
        },
        "related_issues": {
          "type": "array",
          "items": {"type": "string", "pattern": "^ISS-[0-9]{3,}$"},
          "uniqueItems": true
        },
        "related_decisions": {
          "type": "array",
          "items": {"type": "string", "pattern": "^DEC-[0-9]{3,}$"},
          "uniqueItems": true
        },
        "supporting_evidence": {
          "type": "array",
          "items": {"type": "string", "pattern": "^EVD-[0-9]{3,}$"},
          "uniqueItems": true
        },
        "evaluation_reason": {"type": ["string", "null"], "minLength": 1},
        "evaluation_limitations": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "evaluation_history": {
          "type": "array",
          "items": {"$ref": "#/$defs/evaluationHistory"}
        },
        "evaluation_freshness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reasons"],
          "properties": {
            "status": {"enum": ["current", "stale"]},
            "reasons": {
              "type": "array",
              "items": {"type": "string", "minLength": 1},
              "uniqueItems": true
            }
          }
        },
        "milestone_history": {
          "type": "array",
          "items": {"$ref": "#/$defs/milestoneHistory"}
        },
        "created_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"},
        "evaluated_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "retired_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "retirement_reason": {"type": ["string", "null"], "minLength": 1}
      }
    }
  }
}
